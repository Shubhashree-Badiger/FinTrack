POSTGRES_DB=fintrack
POSTGRES_USER=fintrack
POSTGRES_PASSWORD=fintrackpassword
# Used only when running the backend outside Docker (see README, "Run without Docker").
DATABASE_URL=postgresql+psycopg2://fintrack:fintrackpassword@localhost:5432/fintrack
# Signs login tokens. Use a long random value when deploying.
SECRET_KEY=change-me-to-a-long-random-string
